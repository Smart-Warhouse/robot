<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>forklift_mission</name>
  <version>0.1.0</version>
  <description>Behavior-Tree mission executor + MQTT fleet client implementing docs/03-mqtt-contract.md (NV-09, NV-10, SF-05).</description>
  <maintainer email="ahmed.emadtarq@gmail.com">Ahmed Imad Tarq</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>forklift_interfaces</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-paho-mqtt</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
