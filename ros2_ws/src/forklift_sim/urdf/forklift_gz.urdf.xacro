<?xml version="1.0"?>
<!-- Gazebo Fortress twin of one forklift: forklift_description's URDF (same links, frames and dimensions.yaml) plus
     the simulated hardware. Topics are absolute (/<robot_id>/...) and equal the ROS topics of the real robot, so the
     ros_gz_bridge (config/bridge.yaml) maps them 1:1 into the robot namespace:
       RPLIDAR C1   -> gpu_lidar 360 deg, 10 Hz              -> scan          (frame laser)
       MPU9250      -> imu 100 Hz                           -> imu/data      (frame imu)
       fork camera  -> camera 640x480 (rgb8), on the fork   -> image_raw, camera_info (frame camera_optical_frame)
       ESP32 drive  -> VelocityControl (cmd_vel, unicycle)  <- cmd_vel
       ESP32 odom   -> OdometryPublisher 50 Hz (world pose) -> wheel_odom    (odom -> base_link, no TF)
       fork joint   -> JointStatePublisher                  -> joint_states  (robot_state_publisher)
     Drive stand-in: the real forklift is rear-wheel steered (Ackermann); here the body follows cmd_vel (v, w)
     directly on frictionless wheel contacts. Nav2 (Hybrid-A* with minimum_turning_radius) still only plans
     car-like paths. See docs/19-gazebo-sim.md "Known gaps". -->
<robot name="forklift" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="robot_id" default="fl1"/>
  <xacro:arg name="camera_rate" default="15"/>
  <xacro:include filename="$(find forklift_description)/urdf/forklift.urdf.xacro"/>
  <xacro:property name="ns" value="$(arg robot_id)"/>
  <xacro:property name="wy" value="${d['body_width']/2 - d['wheel_width']/2}"/>
  <xacro:property name="r" value="${d['wheel_radius']}"/>

  <!-- contact spheres at the four wheels (the URDF wheels are visual only); lumped into base_link by sdformat -->
  <link name="sim_wheel_contacts">
    <collision><origin xyz="0 ${wy} ${r}"/><geometry><sphere radius="${r}"/></geometry></collision>
    <collision><origin xyz="0 ${-wy} ${r}"/><geometry><sphere radius="${r}"/></geometry></collision>
    <collision><origin xyz="${-d['wheelbase']} ${wy} ${r}"/><geometry><sphere radius="${r}"/></geometry></collision>
    <collision><origin xyz="${-d['wheelbase']} ${-wy} ${r}"/><geometry><sphere radius="${r}"/></geometry></collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="1e-4" iyy="1e-4" izz="1e-4" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="sim_wheel_contacts_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sim_wheel_contacts"/>
  </joint>
  <gazebo reference="sim_wheel_contacts"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>
  <gazebo reference="base_link"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>

  <gazebo reference="laser">
    <sensor name="lidar" type="gpu_lidar">
      <topic>/${ns}/scan</topic>
      <ignition_frame_id>laser</ignition_frame_id>
      <update_rate>10</update_rate>
      <always_on>1</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal><samples>450</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.12763</max_angle></horizontal>
          <vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical>
        </scan>
        <range><min>0.05</min><max>12.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="imu">
    <sensor name="imu" type="imu">
      <topic>/${ns}/imu/data</topic>
      <ignition_frame_id>imu</ignition_frame_id>
      <update_rate>100</update_rate>
      <always_on>1</always_on>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="fork_camera" type="camera">
      <topic>/${ns}/image_raw</topic>
      <ignition_frame_id>camera_optical_frame</ignition_frame_id>
      <update_rate>$(arg camera_rate)</update_rate>
      <always_on>1</always_on>
      <camera>
        <horizontal_fov>1.085</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.02</near><far>10.0</far></clip>
      </camera>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="ignition-gazebo-velocity-control-system" name="ignition::gazebo::systems::VelocityControl">
      <topic>/${ns}/cmd_vel</topic>
    </plugin>
    <plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>/${ns}/wheel_odom</odom_topic>
      <tf_topic>/${ns}/gz/odom_tf</tf_topic>
      <dimensions>2</dimensions>
    </plugin>
    <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher">
      <topic>/${ns}/joint_states</topic>
      <joint_name>fork_lift_joint</joint_name>
    </plugin>
  </gazebo>
</robot>
