# /etc/forklift/forklift.env — per-robot settings for forklift.service (NFR-09: only this file differs)
ROBOT_ID=fl1
ROS_DOMAIN_ID=11
MQTT_HOST=192.168.50.10
FORKLIFT_WS=/home/forklift/grad-project/code/ros2_ws
# FORKLIFT_POLICY=/home/forklift/grad-project/code/training/models/docking_v3/policy.onnx
# extra launch arguments, e.g. "record:=true camera:=false"
FORKLIFT_LAUNCH_ARGS=
# the MQTT password is NOT here: put it in /etc/forklift/mqtt_password (chmod 600, owner forklift)
