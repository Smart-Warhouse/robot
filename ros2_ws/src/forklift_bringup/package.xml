<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>forklift_bringup</name>
  <version>0.1.0</version>
  <description>One launch file per forklift (namespace /flN), all YAML parameters, systemd autostart and rosbag recording (JS-05, JS-07, JS-08).</description>
  <maintainer email="ahmed.emadtarq@gmail.com">Ahmed Imad Tarq</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>micro_ros_agent</exec_depend>
  <exec_depend>sllidar_ros2</exec_depend>
  <exec_depend>laser_filters</exec_depend>
  <exec_depend>v4l2_camera</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_storage_default_plugins</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>forklift_description</exec_depend>
  <exec_depend>forklift_interfaces</exec_depend>
  <exec_depend>forklift_navigation</exec_depend>
  <exec_depend>forklift_perception</exec_depend>
  <exec_depend>forklift_safety</exec_depend>
  <exec_depend>forklift_mission</exec_depend>
  <exec_depend>forklift_rl</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
