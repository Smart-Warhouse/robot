<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>forklift_camera_stream</name>
  <version>0.1.0</version>
  <description>Low-resolution MJPEG stream of the fork camera for manual control, served only in manual mode (UI-08).</description>
  <maintainer email="ahmed.emadtarq@gmail.com">Ahmed Imad Tarq</maintainer>
  <license>MIT</license>


  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>forklift_interfaces</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
